{
  "name": "tabby-bell-indicator",
  "version": "0.1.0",
  "description": "Shows a bell icon on Tabby tab headers when a terminal rings the bell",
  "keywords": [
    "tabby-plugin"
  ],
  "author": "Dario Marcelino",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dmarcelino/tabby-bell-indicator.git"
  },
  "homepage": "https://github.com/dmarcelino/tabby-bell-indicator#readme",
  "bugs": {
    "url": "https://github.com/dmarcelino/tabby-bell-indicator/issues"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "webpack --mode production",
    "watch": "webpack --mode development --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@angular/core": "^15",
    "rxjs": "^7",
    "tabby-core": "*",
    "tabby-terminal": "*"
  },
  "devDependencies": {
    "@angular/animations": "15.2.10",
    "@angular/common": "15.2.10",
    "@angular/core": "15.2.10",
    "@angular/forms": "15.2.10",
    "@angular/platform-browser": "15.2.10",
    "@angular/platform-browser-dynamic": "15.2.10",
    "@types/node": "~20.16.15",
    "jsdom": "^26.1.0",
    "rxjs": "7.8.2",
    "tabby-core": "1.0.231-nightly.0",
    "tabby-terminal": "1.0.231-nightly.0",
    "ts-loader": "^9.5.2",
    "typescript": "~4.9.5",
    "vitest": "^3.2.4",
    "webpack": "^5.99.9",
    "webpack-cli": "^6.0.1"
  }
}
